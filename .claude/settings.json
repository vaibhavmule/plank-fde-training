{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs -I{} \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --write --ignore-unknown {}"
          }
        ]
      }
    ]
  }
}
