# Variable names the app reads. Vercel sets these in deployments;
# src/lib/config.ts falls back to local defaults when they are missing.
VERCEL_ENV=
VERCEL_GIT_COMMIT_SHA=

# Requests live in Postgres. A postgres:// URL uses the server; when this is
# unset the app opens an embedded PGlite database in .data/pg instead.
DATABASE_URL=

# Analytics. Without POSTHOG_KEY nothing is sent, so this is optional locally.
# The project key writes events; the personal key only reads them, and is read
# by the posthog MCP server (mcp/posthog.ts) rather than by the app.
POSTHOG_KEY=
POSTHOG_HOST=
POSTHOG_API_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_KEY=

# Model providers. `pnpm chat` (cli/chat.ts) and `pnpm test:live` are separate
# programs and read these from .env.local themselves.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenRouter is a third, OpenAI-compatible provider. Its model ids carry an
# openai/ prefix, for example openai/gpt-6-luna.
OPENROUTER_API_KEY=

# Web search. Without BRAVE_SEARCH_KEY the web_search tool is not registered.
BRAVE_SEARCH_KEY=
